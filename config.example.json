{
  "host": "127.0.0.1",
  "port": 6969,
  "roots": ["~"],
  "exclude": ["~/Media", "*.photoslibrary"],
  "oneFileSystem": true,
  "includeGlobal": true,
  "workers": 0,
  "minItemSize": "1MB",
  "largeFileSize": "512MB",
  "dupesMinSize": "1MB",
  "readOnly": false,
  "lowPriority": true,
  "defaultAction": "auto",
  "schedule": "24h",
  "notifyAbove": "5GB",
  "disabledRules": ["large-file"],
  "rules": [
    {
      "id": "my-tmp-builds",
      "name": "Scratch builds",
      "category": "build",
      "risk": "safe",
      "dirs": ["tmp-build", "scratch-*"],
      "siblings": ["Makefile"],
      "regen": "make"
    },
    {
      "id": "old-recordings",
      "name": "Screen recordings",
      "category": "large",
      "risk": "review",
      "paths": ["{home}/Videos/Screencasts/*"]
    }
  ]
}
